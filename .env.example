# --- Database (libSQL / Turso). Leave blank to use a local file db. ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin console credentials ---
ADMIN_USER=admin
ADMIN_PASS=change-me

# --- Session signing secret (required in production) ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=4000

# --- Market data (CoinGecko public API; no key needed for the free tier) ---
COINGECKO_API_KEY=

# --- Object storage for chat attachments / KYC (optional; falls back to disk) ---
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
