# Copy to .env for local development. In production (Railway and friends) set
# these as environment variables instead — do not ship a .env file.

# --- Database (libSQL / Turso) -------------------------------------------
# Leave both blank to use a local file at server/deficoins.db. On a host with
# an ephemeral filesystem that local file is wiped on every deploy, so a
# production deployment must point at Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Admin console -------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASS=change-me

# --- Session signing -----------------------------------------------------
# Every session token is signed with this. The server refuses to start without
# it when NODE_ENV=production. Changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Server --------------------------------------------------------------
# Railway injects PORT itself; leave this unset there. 4000 is the local default.
PORT=4000

# --- Market data ---------------------------------------------------------
# Optional. The CoinGecko free tier needs no key; set one to raise the rate limit.
COINGECKO_API_KEY=
